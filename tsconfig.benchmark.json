{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "rootDir": ".",
    "outDir": "benchmark/lua",
    "types": ["@typescript-to-lua/language-extensions", "lua-types/5.1", "luamark-types"],
    "composite": true
  },
  "tstl": {
    "luaTarget": "5.1",
    "noImplicitSelf": true,
    "noImplicitGlobalVariables": true,
    "noHeader": true,
    "luaLibImport": "require-minimal",
    "luaPlugins": [{ "name": "./dist/index.js" }],
    "noResolvePaths": ["luamark"]
  },
  "include": ["benchmark/**/*.ts"]
}
