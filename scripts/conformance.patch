diff --git a/test/unit/tstl-optimize-canary.spec.ts b/test/unit/tstl-optimize-canary.spec.ts
new file mode 100644
--- /dev/null
+++ b/test/unit/tstl-optimize-canary.spec.ts
@@ -0,0 +1,13 @@
+import * as util from "../util";
+
+// Guards against the optimize plugin silently becoming a no-op: if optimizations
+// stopped applying, the rest of the conformance suite would stay green while
+// exercising stock TSTL only.
+const testIfOptimize = process.env.TSTL_OPTIMIZE_PLUGIN ? test : test.skip;
+
+testIfOptimize("tstl-optimize canary: plugin transforms output", () => {
+    const lua = util.testFunction`
+        return 2 + 3;
+    `.getMainLuaCodeChunk();
+    expect(lua).toContain("return 5");
+});
