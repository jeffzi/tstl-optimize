// Type-check only — the plugin is not invoked here. Example .lua files are
// produced by scripts/examples.ts via tstl.transpileVirtualProject. See
// ../README.md#usage for a runnable end-to-end tsconfig.
{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@typescript-to-lua/language-extensions"],
    "noEmit": true,
    "noUnusedLocals": true
  },
  "include": ["*.ts"]
}
