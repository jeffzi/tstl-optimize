{
  "name": "tstl-optimize",
  "version": "0.10.0",
  "description": "TSTL plugin with configurable optimization rules for faster Lua output",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ts-ast": {
      "types": "./dist/ast/ts-ast-public.d.ts",
      "require": "./dist/ast/ts-ast-public.js",
      "default": "./dist/ast/ts-ast-public.js"
    },
    "./lua-ast": {
      "types": "./dist/ast/lua-ast-public.d.ts",
      "require": "./dist/ast/lua-ast-public.js",
      "default": "./dist/ast/lua-ast-public.js"
    },
    "./transforms": {
      "types": "./dist/lua-transforms/index.d.ts",
      "require": "./dist/lua-transforms/index.js",
      "default": "./dist/lua-transforms/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.plugin.json",
    "test": "vitest run --coverage && tsx scripts/conformance.ts",
    "test:unit": "vitest run --coverage",
    "test:runtime": "vitest run --config vitest.config.runtime.ts",
    "test:conformance": "tsx scripts/conformance.ts",
    "check": "biome check --fix .",
    "check:md": "markdownlint-cli2 '**/*.md' '#node_modules' '#.conformance' '#.planning' '#.research' '#research' '#plans' '#CLAUDE.md'",
    "check:unused": "knip",
    "typecheck": "tsc -p tsconfig.plugin.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "validate": "npm run check && npm run typecheck && npm run check:unused",
    "examples": "npm run build && tsx scripts/examples.ts",
    "examples:check": "npm run build && tsx scripts/examples.ts --check",
    "bench": "npm run build && npx tstl -p tsconfig.benchmark.json && npx tstl -p tsconfig.benchmark-jit.json && tsx scripts/bench.ts",
    "prepack": "tsc -p tsconfig.plugin.json",
    "prepare": "npm run build && (test -d .git && lefthook install || true)"
  },
  "peerDependencies": {
    "typescript-to-lua": ">=1.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/luaparse": "^0.2.0",
    "@types/node": "^25.9.0",
    "@vitest/coverage-v8": "^4.1.0",
    "dprint": "^0.54.0",
    "fast-check": "^4.8.0",
    "knip": "^6.16.1",
    "lefthook": "^2.1.0",
    "lua-types": "^2.14.0",
    "luamark-types": "github:jeffzi/luamark#ts-types",
    "markdownlint-cli2": "^0.22.0",
    "source-map": "^0.7.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0",
    "typescript-to-lua": "^1.36.0",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tstl",
    "typescript-to-lua",
    "plugin",
    "lua",
    "optimization",
    "performance"
  ],
  "dependencies": {
    "luaparse": "^0.3.0",
    "ts-api-utils": "^2.5.0"
  }
}
