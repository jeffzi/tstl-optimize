{
  "name": "tstl-optimize",
  "version": "0.4.0",
  "description": "TSTL plugin with configurable optimization rules for faster Lua output",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.plugin.json",
    "test": "vitest run && node scripts/conformance.mjs",
    "test:unit": "vitest run",
    "test:conformance": "node scripts/conformance.mjs",
    "check": "biome check --fix .",
    "check:md": "markdownlint-cli2 '**/*.md' '#node_modules' '#.conformance' '#research' '#plans'",
    "check:unused": "knip",
    "typecheck": "tsc -p tsconfig.plugin.json --noEmit",
    "validate": "npm run check && npm run typecheck && npm run check:unused",
    "examples": "npm run build && node scripts/examples.mjs",
    "examples:check": "node scripts/examples.mjs --check",
    "bench": "echo 'Use: task bench (requires go-task)' && exit 1",
    "prepack": "tsc -p tsconfig.plugin.json",
    "prepare": "npm run build && (test -d .git && lefthook install || true)"
  },
  "peerDependencies": {
    "typescript-to-lua": ">=1.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.0",
    "dprint": "^0.52.0",
    "knip": "^5.85.0",
    "lefthook": "^2.1.0",
    "lua-types": "^2.13.0",
    "luamark-types": "github:jeffzi/luamark#ts-types",
    "markdownlint-cli2": "^0.21.0",
    "typescript": "^5.9.0",
    "typescript-to-lua": "^1.33.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tstl",
    "typescript-to-lua",
    "plugin",
    "lua",
    "optimization",
    "performance"
  ],
  "dependencies": {
    "ts-api-utils": "^2.4.0"
  }
}
